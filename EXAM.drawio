        <mxCell id="Y_5v1F7r3MniF2OiO2Z--161" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,0&quot;&gt;&amp;nbsp;Help seeker posts multiple HelpRequests.&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,0&quot;&gt;&amp;nbsp;Helper can be assigned to multiple HelpRequests and can submit multiple Offers&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,1&quot;&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,2&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,2&quot;&gt;Each HelpRequest can receive multiple Offers, contains multiple Messages, and trigger multiple Notifications&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,3&quot;&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,4&quot;&gt;. Feach HelpRequest can receive one optional Review&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,5&quot;&gt;&lt;span&gt;&lt;sup class=&quot;superscript&quot;&gt;&lt;/sup&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;&quot; data-path-to-node=&quot;0,6&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
